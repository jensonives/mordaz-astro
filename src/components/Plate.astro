---
/**
 * A piece's image.
 *
 * With a photograph: renders it, and the CSS grades it into the site's three
 * colours automatically.
 * Without one: renders an empty frame that plates.js fills with the received
 * view set at poster scale and struck through in red.
 *
 * The claim used to live in three places that had to be kept in step by hand
 * (data-plate, aria-label, the no-JS fallback). Here they all come off one prop.
 */
interface Props {
  theySay: string;
  photo?: string;
  photoAlt?: string;
  photoCredit?: string;
  /** Extra classes for the frame — e.g. "card__fig" or "afig__img plate--wide" */
  class?: string;
}

const { theySay, photo, photoAlt, photoCredit, class: cls = '' } = Astro.props;
const label = `Plate: the received view — ${theySay} — struck through in red.`;
---
{photo ? (
  <figure class={`plate ${cls}`}>
    <img src={photo.startsWith('/') ? photo : `/${photo}`} alt={photoAlt} />
    {photoCredit && <span class="plate__credit">{photoCredit}</span>}
  </figure>
) : (
  <figure class={`plate ${cls}`} data-plate={theySay} role="img" aria-label={label}>
    <span class="plate__fallback">They say: &ldquo;{theySay}&rdquo;</span>
  </figure>
)}
