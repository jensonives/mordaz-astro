---
/**
 * A piece's image.
 *
 * With a photograph: renders it, and the CSS grades it into the site's three
 * colours automatically.
 * Without one: renders an empty frame that plates.js fills with the piece's
 * topic set at poster scale.
 *
 * `topic` arrives already resolved — the piece's own label if it set one,
 * otherwise its beat — so the fallback logic lives in one place rather than
 * at each of the three call sites.
 */
interface Props {
  /** Short label for the generated plate, e.g. "UK politics". */
  topic: string;
  photo?: string;
  photoAlt?: string;
  photoCredit?: string;
  /** Extra classes for the frame — e.g. "card__fig" or "afig__img plate--wide" */
  class?: string;
}

const { topic, photo, photoAlt, photoCredit, class: cls = '' } = Astro.props;
---
{photo ? (
  <figure class={`plate plate--photo ${cls}`}>
    <img src={photo.startsWith('/') ? photo : `/${photo}`} alt={photoAlt} />
    {/* The same label a generated plate carries, so a piece with a photograph
        still reads as one of the set rather than a stock-image blog post. */}
    <span class="plate__label" aria-hidden="true">
      <span class="plate__eyebrow">Mordaz</span>
      <span class="plate__rule"></span>
      <span class="plate__topic">{topic}</span>
    </span>
    {photoCredit && <span class="plate__credit">{photoCredit}</span>}
  </figure>
) : (
  <figure class={`plate ${cls}`} data-plate={topic} role="img" aria-label={`Illustration: ${topic}`}>
    <span class="plate__fallback">{topic}</span>
  </figure>
)}
